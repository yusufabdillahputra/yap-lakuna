# Salin menjadi .env lalu isi. Jangan commit .env (berisi rahasia).
# Rahasia acak: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# --- Wajib ---------------------------------------------------------------
# Domain server (A record ke IP VPS), mis. sync.tokoanda.id. Alamat ini
# yang diisi di aplikasi: https://sync.tokoanda.id
LAKUNA_DOMAIN=sync.tokoanda.id
# Email untuk sertifikat HTTPS Let's Encrypt (pemberitahuan kedaluwarsa).
ACME_EMAIL=admin@tokoanda.id

POSTGRES_PASSWORD=
SERVICE_SECRET=
EMAIL_SECRET_HASH_PEPPER=
JWT_HMAC_SHA512_PRIVATE_KEY=
JWT_REFRESH_TOKEN_HASH_PEPPER=

# --- Email kode verifikasi pemilik (disarankan) -------------------------
# Tanpa SMTP kode verifikasi hanya tercatat di tabel serverpod_log
# (query di docs/server/vps.md, langkah 4).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Gambar di object storage (opsional) --------------------------------
# Kosong = gambar disimpan di database Postgres. Untuk object storage di
# VPS yang sama (SeaweedFS): jalankan dengan --profile s3, arahkan
# MEDIA_DOMAIN ke IP VPS,
# dan isi S3_ENDPOINT=https://<MEDIA_DOMAIN>. Alamat ini harus bisa
# dibuka dari perangkat kasir (URL unggah/unduh ditandatangani untuk
# alamat ini), jadi jangan pakai http://s3:8333. Tambahkan juga
# COMPOSE_PROFILES=s3 agar pull/up/down selalu menyertakan SeaweedFS.
# Kunci SeaweedFS: huruf/angka saja, mis. S3_SECRET_KEY=$(openssl rand -hex 24).
# Untuk object storage penyedia (IDCloudhost Object Storage, Cloudflare R2,
# Wasabi, dll.) isi S3_* dari penyedia dan kosongkan
# MEDIA_DOMAIN.
MEDIA_DOMAIN=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lakuna-media
S3_REGION=us-east-1

# --- Lain-lain ----------------------------------------------------------
# Hanya untuk uji di komputer sendiri tanpa domain: LAKUNA_DOMAIN=localhost,
# LAKUNA_SCHEME=http, LAKUNA_PUBLIC_PORT=80. Di VPS biarkan https/443.
LAKUNA_SCHEME=https
LAKUNA_PUBLIC_PORT=443
# Hari backup harian disimpan di volume `backups`.
BACKUP_KEEP_DAYS=14
# Batas permintaan per IP per menit: aktivasi/kode pasang/login, dan sync.
AUTH_RATE_LIMIT=30
SYNC_RATE_LIMIT=600
# Image yang dipakai (bawaan: rilis terbaru dari GitHub Container Registry).
# Kunci ke versi tertentu, mis. ghcr.io/yusufabdillahputra/lakuna-server:0.168.0
LAKUNA_SERVER_IMAGE=ghcr.io/yusufabdillahputra/lakuna-server:latest
LAKUNA_CADDY_IMAGE=ghcr.io/yusufabdillahputra/lakuna-caddy:latest
